@model MvcBooks.Models.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@using MvcBooks.Common
@using System.Text.Json 
@using System.Text.Encodings.Web 

@{
    ViewData["Title"] = "Library Home";

    // --- Prepare Data SERVER-SIDE ---

    // 1. Prepare the object structure needed for JavaScript
    var categoriesForJs = Model.FilterableCategories?
        .Select(c => new { id = c.Id, text = c.Name }) // Create anonymous objects
        ?? Enumerable.Empty<object>();

    var selectedIdsForJs = Model.SelectedCategoryIds ?? new List<int>();

    // 2. Serialize these prepared objects/lists into JSON strings
    var filterableCategoriesJson = JsonSerializer.Serialize(categoriesForJs);
    var selectedCategoryIdsJson = JsonSerializer.Serialize(selectedIdsForJs);

    // 3. Escape the JSON strings for safe embedding in JavaScript string literals
    var escapedFilterableCategoriesJson = JavaScriptEncoder.Default.Encode(filterableCategoriesJson);
    var escapedSelectedCategoryIdsJson = JavaScriptEncoder.Default.Encode(selectedCategoryIdsJson);

    // Determine display conditions
    bool filtersApplied = Model.SelectedCategoryIds != null && Model.SelectedCategoryIds.Any();
    bool showUserHistory = SignInManager.IsSignedIn(User) && Model.UserHistoryBooks.Any() && !filtersApplied;
}

@* --- Hero Billboard Section --- *@
<div class="hero-billboard">
    <div class="hero-content text-center">
         <h1 class="display-5 fw-bold hero-title">wdt</h1>
         <p class="fs-5 hero-subtitle"></p>
    </div>
</div>

@* --- Main Content --- *@
<div class="library-home container mt-4">

    @if (showUserHistory)
    {
        <div class="category-row user-history-row">
            <h2 class="category-title">My Recently Added Books</h2>
            <div class="book-list-wrapper">
                <div class="book-list">
                    @foreach (var book in Model.UserHistoryBooks)
                    {
                        <div class="book-item">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" title="@book.Title">
                                <img src="@(book.CoverImageUrl ?? Constants.DefaultCoverImagePath)"
                                     alt="Cover for @book.Title" class="book-cover" loading="lazy" decoding="async"
                                     onerror="this.onerror=null; this.src='@Constants.DefaultCoverImagePath';" />
                                <span class="book-title-sm">@book.Title</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
             <hr class="my-5"/>
        </div>
    }

    @if (!Model.PublicCategories.Any())
    {
        <div class="text-center mt-5 pt-3">
            @if (filtersApplied)
            {
                <p class="lead text-muted">No public books found matching the selected categories.</p>
                <a href="#" onclick="clearNavbarFilters(); return false;" class="btn btn-sm btn-outline-secondary mt-2">
                     <i class="fas fa-times me-1"></i> Clear Category Filter
                </a>
            }
            else if (!showUserHistory)
            {
                 <p class="lead text-muted">No public books found.</p>
                 @if (SignInManager.IsSignedIn(User))
                 { <p>You can <a asp-controller="Books" asp-action="Create">add your own books</a>!</p> }
                 else
                 { <p><a asp-area="Identity" asp-page="/Account/Login">Login</a> or <a asp-area="Identity" asp-page="/Account/Register">Register</a> to add books.</p> }
            }
        </div>
    }
    else
    {
        @foreach (var category in Model.PublicCategories)
        {
            <div class="category-row public-category-row-@category.Id">
                <h2 class="category-title">@category.Name</h2>
                <div class="book-list-wrapper">
                    <div class="book-list">
                        @if (!category.Books.Any())
                        { <p class="text-muted ms-2 fst-italic" style="white-space: normal;">No public books available in this category currently.</p> }
                        else
                        {
                            @foreach (var book in category.Books)
                            {
                                <div class="book-item">
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" title="@book.Title">
                                        <img src="@(book.CoverImageUrl ?? Constants.DefaultCoverImagePath)"
                                             alt="Cover for @book.Title" class="book-cover" loading="lazy" decoding="async"
                                             onerror="this.onerror=null; this.src='@Constants.DefaultCoverImagePath';" />
                                        <span class="book-title-sm">@book.Title</span>
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    }

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        // --- Prepare Data SERVER-SIDE ---
        var categoriesForJs = Model.FilterableCategories?.Select(c => new { id = c.Id, text = c.Name }) ?? Enumerable.Empty<object>();
        var selectedIdsForJs = Model.SelectedCategoryIds ?? new List<int>();
        var filterableCategoriesJson = System.Text.Json.JsonSerializer.Serialize(categoriesForJs);
        var selectedCategoryIdsJson = System.Text.Json.JsonSerializer.Serialize(selectedIdsForJs);
        var escapedFilterableCategoriesJson = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(filterableCategoriesJson);
        var escapedSelectedCategoryIdsJson = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(selectedCategoryIdsJson);
    }
    <script nonce="RANDOM_NONCE_PLACEHOLDER"> // Add nonce if using CSP
        // Embed the pre-escaped JSON strings
        const filterableCategoriesJsonString = '@Html.Raw(escapedFilterableCategoriesJson)';
        const selectedIdsJsonString = '@Html.Raw(escapedSelectedCategoryIdsJson)';

        // Use DOMContentLoaded to ensure parsing happens after DOM ready AND
        // to ensure site.js has loaded and defined initializeCategoryDropdown on window
        document.addEventListener('DOMContentLoaded', () => {
            let localFilterableCategories = [];
            let localInitiallySelectedIds = [];

            try {
                // Parse the JSON strings
                 if (filterableCategoriesJsonString && filterableCategoriesJsonString !== "''" && filterableCategoriesJsonString !== '""') {
                     localFilterableCategories = JSON.parse(filterableCategoriesJsonString);
                 }
                 if (selectedIdsJsonString && selectedIdsJsonString !== "''" && selectedIdsJsonString !== '""') {
                     localInitiallySelectedIds = JSON.parse(selectedIdsJsonString).map(String);
                 }
            } catch (e) {
                console.error("Error parsing category data from server:", e); // Keep this critical error log
            }

            // Explicitly Call the Initialization Function from site.js
            if (typeof window.initializeCategoryDropdown === 'function') {
                window.initializeCategoryDropdown(localFilterableCategories, localInitiallySelectedIds);
            } else {
                console.error("initializeCategoryDropdown function not found. Check site.js load order.");
                // Attempt a fallback call after a small delay
                setTimeout(() => {
                    if (typeof window.initializeCategoryDropdown === 'function') {
                        window.initializeCategoryDropdown(localFilterableCategories, localInitiallySelectedIds);
                    } else {
                         console.error("initializeCategoryDropdown function STILL not found after delay.");
                    }
                }, 100); // Wait 100ms
            }
        });
    </script>
}