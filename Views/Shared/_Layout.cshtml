<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MvcBooks</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/MvcBooks.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sticky-top shadow-sm">
        @* --- Single Top Navigation Bar --- *@
        <nav class="navbar navbar-expand-md navbar-dark bg-dark custom-navbar-top">
            @* container-fluid allows content to stretch edge-to-edge within nav padding *@
            <div class="container-fluid d-flex align-items-center"> @* Explicitly use d-flex *@

                @* Logo - Left (Doesn't grow/shrink) *@
                <a class="navbar-brand flex-shrink-0 me-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.webp" alt="MvcBooks Library Logo" class="navbar-logo" />
                </a>

                @* Search/Filter Form Container - Grows to fill space *@
                <div class="flex-grow-1 mx-2 navbar-search-wrapper"> @* flex-grow-1 takes available space, mx-2 adds spacing *@
                    <form class="d-flex search-filter-form position-relative"
                          role="search" method="get" asp-controller="Home" asp-action="Index"
                          id="navbarSearchFilterForm" autocomplete="off">

                        @* Filter Button & Dropdown Wrapper *@
                        <div class="search-filter-button-wrapper position-relative me-1"> @* Reduced margin *@
                            <button type="button" class="btn btn-sm btn-outline-secondary filter-button"
                                    id="navbarFilterButton">
                                <i class="fas fa-filter"></i><span class="d-none d-md-inline ms-1">Filter</span> @* Show text md+ *@
                                <span id="filter-badge" class="badge bg-primary ms-1" style="display: none;">0</span>
                            </button>
                            <div class="category-filter-dropdown shadow-sm" id="categoryFilterDropdown">
                                @* ... Dropdown Content (Header, List Div, Footer) ... *@
                                <div class="dropdown-header px-3 py-2">Filter by Category</div>
                                <div class="dropdown-divider my-1"></div>
                                <div class="category-list-scrollable px-3 py-2" id="dropdownCategoryList">...</div>
                                <div class="dropdown-divider my-1"></div>
                                <div class="dropdown-footer p-2 text-end">...</div>
                            </div>
                        </div> @* End Filter Wrapper *@

                        @* Search Input Group - Takes remaining space within the form *@
                        <div class="input-group input-group-sm search-input-wrapper flex-grow-1"> @* flex-grow-1 is key here *@
                            <input class="form-control" type="search" id="navbarSearchInput" name="searchTerm"
                                   placeholder="Search books..." aria-label="Search" aria-haspopup="listbox"
                                   aria-controls="search-suggestions" value="@ViewContext.HttpContext.Request.Query["searchTerm"]">
                            <button class="btn btn-primary search-button" type="button" id="navbarSearchSubmitButton">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>

                        @* Search Suggestions List (Positioned relative to form) *@
                        <ul id="search-suggestions" class="dropdown-menu search-suggestions-list" aria-labelledby="navbarSearchInput"></ul>

                    </form> @* End Search Form *@
                </div> @* End Search Wrapper *@


                @* Login/Profile Section - Right (Doesn't grow/shrink) *@
                <div class="flex-shrink-0 ms-1" id="navbarLoginContainer"> @* Use wrapper for Login Partial *@
                     <partial name="_LoginPartial" /> @* Renders the UL directly *@
                </div>

                @* Hamburger Toggler REMOVED *@
                @* Collapsible Div REMOVED *@

            </div> @* End Container Fluid *@
        </nav> @* End Top Navbar *@
         @* Separate Search Bar REMOVED *@
    </header>

    @* Main Content Area *@
    <div class="container main-content-area mt-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <div class="modal fade" id="addBookModal" tabindex="-1" aria-labelledby="addBookModalLabel" aria-hidden="true">
         <div class="modal-dialog modal-lg modal-dialog-scrollable">
             <div class="modal-content">
                 <div class="modal-header bg-light">
                     <h5 class="modal-title" id="addBookModalLabel"><i class="fas fa-plus-circle me-2 text-success"></i>Add New Book</h5>
                     <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                 </div>
                 <div class="modal-body">
                     <div id="addBookModalBodyContent"> @* JS loads form here *@</div>
                 </div>
                 <div class="modal-footer">
                     <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                     <button type="button" class="btn btn-success" id="createBookSubmitButton"> @* Changed to type="button", JS handles submit *@
                        <i class="fas fa-check me-1"></i> Create Book
                     </button>
                 </div>
             </div>
         </div>
    </div> @* --- End Add Book Modal --- *@


    @* Footer *@
    <footer class="border-top footer text-muted mt-auto py-3">
        <div class="container text-center"> © @DateTime.Now.Year - MvcBooks - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> </div>
    </footer>

    @* Scripts *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>