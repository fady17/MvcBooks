@using Microsoft.AspNetCore.Identity
@using MvcBooks.Models

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul class="navbar-nav align-items-center flex-row"> @* flex-row keeps items horizontal *@

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var profilePictureUrl = currentUser?.ProfilePictureUrl;
    var placeholderProfilePic = "/images/placeholder-profile.webp";

    @* Add Book Button *@
    <li class="nav-item me-2">
        <button type="button" class="btn btn-sm btn-success add-book-btn"
                data-bs-toggle="modal" data-bs-target="#addBookModal"
                title="Add New Book">
            <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">Add Book</span>
        </button>
    </li>

    @* Profile Dropdown *@
    <li class="nav-item dropdown">
         <a class="nav-link dropdown-toggle text-light d-flex align-items-center p-0"
            href="#" id="userDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false"
            title="Account Options">
             <img src="@(profilePictureUrl ?? placeholderProfilePic)" alt="Profile" class="rounded-circle profile-picture-nav" onerror="this.onerror=null; this.src='@placeholderProfilePic';" />
         </a>
         <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdownMenuLink">
             <li><h6 class="dropdown-header">@UserManager.GetUserName(User)</h6></li>
             <li><hr class="dropdown-divider"></li>
             <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="fas fa-user-cog me-2 fa-fw"></i>Manage Account</a></li>
             <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/MyBooks"><i class="fas fa-book me-2 fa-fw"></i>My Books</a></li>
             <li><hr class="dropdown-divider"></li>
             <li>
                  <form id="logoutForm" class="form-inline d-grid" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                      <button id="logout" type="submit" class="btn btn-link dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2 fa-fw"></i>Logout</button>
                  </form>
             </li>
         </ul>
    </li>
}
else // Logged out
{
    <li class="nav-item me-2"> <a class="btn btn-sm btn-outline-light" asp-area="Identity" asp-page="/Account/Register">Register</a> </li>
    <li class="nav-item"> <a class="btn btn-sm btn-light" asp-area="Identity" asp-page="/Account/Login">Login</a> </li>
}
</ul>