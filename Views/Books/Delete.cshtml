@model MvcBooks.Models.Book 

@{
    ViewData["Title"] = "Delete Confirmation";
    var bookTitle = ViewData["BookTitle"] as string ?? "this book";
    var bookAuthor = ViewData["BookAuthor"] as string;
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="alert alert-danger" role="alert">
    <h4 class="alert-heading">Are you sure you want to delete this book?</h4>
    <p>This action cannot be undone. Deleting this book will attempt to remove associated files (Cover Image, EPUB/PDF file) from storage.</p>
</div>

<div>
    <h4>@bookTitle</h4>
    @if (!string.IsNullOrEmpty(bookAuthor) && bookAuthor != "N/A")
    {
        <p class="text-muted">by @bookAuthor</p>
    }
    <hr />
    @* Removed the <dl> list as the full model isn't passed anymore *@

    <form asp-action="Delete" method="post">
        @* Bind the hidden ID from the minimal model *@
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash-alt"></i> Yes, Delete Permanently
        </button>
        <a asp-area="Identity" asp-page="/Account/Manage/MyBooks" class="btn btn-outline-secondary ms-2">
             <i class="fas fa-times"></i> Cancel
        </a>
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}