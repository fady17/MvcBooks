@page
@model MyBooksModel
@{
    ViewData["Title"] = "My Uploaded Books";
    ViewData["ActivePage"] = ManageNavPages.MyBooks;
}

<h4>@ViewData["Title"]</h4>

<partial name="_StatusMessage" model="Model.StatusMessage" />

<div class="row">
    <div class="col-md-12">
        @if (!Model.UserBooks.Any())
        {
            <div class="alert alert-info mt-3" role="alert">
                You haven't uploaded any books yet.
                <a asp-controller="Books" asp-action="Create" class="alert-link">Add your first book!</a>
            </div>
        }
        else
        {
            <table class="table table-striped table-hover mt-3">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Cover</th>
                        <th>Title</th>
                        <th class="d-none d-md-table-cell">Author</th>
                        <th class="text-center">Status</th> @* Changed from Public? *@
                        <th class="text-center">Source Type</th> @* Added Source Type *@
                        <th style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.UserBooks)
                    {
                        <tr>
                            <td class="text-center align-middle">
                                <img src="@(string.IsNullOrEmpty(item.CoverImageUrl) ? "/images/placeholder-cover.png" : item.CoverImageUrl)"
                                     alt="Cover for @item.Title"
                                     style="max-height: 50px; width: auto;"
                                     class="img-thumbnail"
                                     onerror="this.onerror=null; this.src='/images/placeholder-cover.png';" />
                            </td>
                            <td class="align-middle">@Html.DisplayFor(modelItem => item.Title)</td>
                            <td class="align-middle d-none d-md-table-cell">@(item.Author ?? "N/A")</td>
                            <td class="align-middle text-center">
                                @if(item.IsPublic) { <span class="badge bg-success" title="Visible on Home Page"><i class="fas fa-eye"></i> Public</span> }
                                else { <span class="badge bg-secondary" title="Private to your account"><i class="fas fa-lock"></i> Private</span> }
                            </td>
                            @* --- START: Display Source Type --- *@
                            <td class="align-middle text-center small">
                                @if (item.BookSourceType == "MINIO_EPUB") {
                                    <span class="badge bg-info text-dark">EPUB</span>
                                } else if (item.BookSourceType == "MINIO_PDF") {
                                     <span class="badge bg-warning text-dark">PDF</span>
                                } else if (item.BookSourceType == "EXTERNAL") {
                                     <span class="badge bg-light text-dark">URL</span>
                                } else {
                                     <span class="badge bg-light text-danger">N/A</span>
                                }
                            </td>
                            @* --- END: Display Source Type --- *@
                            <td class="align-middle text-center">
                                <div class="btn-group" role="group" aria-label="Book Actions">
                                     <a asp-controller="Books" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="View Details"><i class="fas fa-info-circle"></i></a>
                                     <a asp-controller="Books" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Edit Book"><i class="fas fa-edit"></i></a>
                                     <a asp-controller="Books" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Delete Book"><i class="fas fa-trash-alt"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
             @* TODO: Add Pagination controls here if needed *@
        }
    </div>
</div>

@section Scripts {
     <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <partial name="_ValidationScriptsPartial" />
}